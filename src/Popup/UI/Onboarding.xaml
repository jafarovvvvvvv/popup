<Window x:Class="Popup.UI.Onboarding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Width="560" Height="380"
        FontFamily="{StaticResource UiFont}">

    <!--
        Знакомство показывается один раз и объясняет ровно то, что нельзя
        обнаружить самому: панель невидима, пока к ней не подвести курсор.
        Всё остальное человек найдёт, наводя мышь, — и рассказывать ему об этом
        значит задерживать на экране приветствие вместо работы.
    -->
    <Border CornerRadius="18" Background="#F2101010" BorderThickness="1"
            BorderBrush="{StaticResource Hairline}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270"
                              Color="Black" Opacity="0.55" />
        </Border.Effect>

        <Grid Margin="34,30,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Картинка страницы: рисуется кодом, у каждой своя -->
            <ContentControl x:Name="Illustration" Grid.Row="0" Height="120"
                            HorizontalAlignment="Center" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,0">
                <TextBlock x:Name="TitleText"
                           FontSize="21" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText"
                           Margin="0,10,0,0"
                           FontSize="13.5" LineHeight="21"
                           Foreground="{StaticResource TextSecondary}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SkipButton" Grid.Column="0"
                        Style="{StaticResource NotchTextButton}"
                        HorizontalAlignment="Left" />

                <!-- Точки-страницы -->
                <StackPanel x:Name="Dots" Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />

                <Button x:Name="NextButton" Grid.Column="2"
                        Style="{StaticResource NotchTextButton}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>
