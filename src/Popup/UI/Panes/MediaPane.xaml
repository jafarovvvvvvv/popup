<UserControl x:Class="Popup.UI.Panes.MediaPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Popup.UI">

    <Grid>
        <!-- Ничего не играет. Это статус, а не подсказка: пустая вкладка сама по
             себе не сказала бы, тишина сейчас или панель не смогла прочитать. -->
        <StackPanel x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Path Data="{StaticResource IconMusic}"
                  Stroke="{StaticResource TextTertiary}"
                  StrokeThickness="1.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="16" Height="16" Stretch="None"
                  HorizontalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                </Path.RenderTransform>
            </Path>
            <TextBlock x:Name="EmptyLabel"
                       Margin="0,14,0,0"
                       FontSize="12" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="Playing" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Обложка. Та же скруглённая рамка служит и маской, и границей:
                 картинка от видео в браузере приходит 16:9 и без обрезки
                 вылезала бы далеко за края, накрывая рейл. -->
            <Border Grid.Column="0"
                    Width="118" Height="118"
                    CornerRadius="14"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="{StaticResource Hairline}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="270"
                                      Color="Black" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Width="118" Height="118" CornerRadius="14" Background="White" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.OpacityMask>
                    <!-- Пока обложки нет — ровная плашка, а не пустое место:
                         дырка в раскладке читается как поломка. -->
                    <Border x:Name="ArtworkPlaceholder" Background="{StaticResource Surface}" />
                    <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18,0,0,0" Height="122" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText" Grid.Row="0"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,3,0,0"
                           FontSize="11.5"
                           Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PreviousButton" Style="{StaticResource NotchButton}" Width="30" Height="30">
                        <Path Data="{StaticResource IconPrev}" Fill="{StaticResource TextPrimary}"
                              Width="16" Height="16" Stretch="None" />
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource NotchButton}"
                            Width="40" Height="40" Margin="20,0">
                        <Path x:Name="PlayGlyph" Data="{StaticResource IconPlay}"
                              Fill="{StaticResource TextPrimary}"
                              Width="16" Height="16" Stretch="None"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource NotchButton}" Width="30" Height="30">
                        <Path Data="{StaticResource IconNext}" Fill="{StaticResource TextPrimary}"
                              Width="16" Height="16" Stretch="None" />
                    </Button>
                </StackPanel>

                <!-- Полоска перемотки -->
                <Grid Grid.Row="5" Height="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ElapsedText" Grid.Column="0"
                               FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource TextTertiary}"
                               VerticalAlignment="Center" />

                    <Grid x:Name="ScrubTrack" Grid.Column="1" Margin="10,0"
                          Background="Transparent" Cursor="Hand">
                        <Border x:Name="TrackBase" Height="4" CornerRadius="2"
                                Background="{StaticResource Surface}"
                                VerticalAlignment="Center" />
                        <!-- Заполнение нарочно без анимации: перемотка обязана
                             оказаться под курсором сразу. Плавность даёт частота
                             тиков, а не сглаживание. -->
                        <Border x:Name="TrackFill" Height="4" CornerRadius="2"
                                Background="#E6FFFFFF"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        <Ellipse x:Name="ScrubKnob" Width="11" Height="11" Fill="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Visibility="Collapsed">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0"
                                                  Color="Black" Opacity="0.4" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <TextBlock x:Name="DurationText" Grid.Column="2"
                               FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource TextTertiary}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
